# Zsh configuration
export EDITOR=vim
PROMPT_EOL_MARK=''

# Enable Zsh completions
autoload -Uz compinit
compinit -d ~/.zsh/cache/.zcompdump-$HOST

# Case-insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

if [ -e "/opt/homebrew" ]; then
  export PATH="/opt/homebrew/bin:$PATH"
  export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
  export PATH="/opt/homebrew/opt/binutils/bin:$PATH"
  export PATH="/opt/homebrew/opt/bzip2/bin:$PATH"
  export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
fi

[ -e "$HOME/Tools" ] && export PATH="$HOME/Tools:$PATH"
[ -e "$HOME/.opencode" ] && export PATH="$HOME/.opencode/bin:$PATH"
[ -e "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"
[ -e "/opt/homebrew/opt/ruby/bin" ] && export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
[ -e "/home/linuxbrew/.linuxbrew/bin" ] && export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

for f in $(find ~/.zsh/plugins/ -maxdepth 1 -type f -name '*.zsh'); do
  source $f;
done

command -v keychain > /dev/null && keychain -q ~/.ssh/id_ed25519
command -v zeditor > /dev/null && alias zed='zeditor'
command -v nvim > /dev/null && alias vim='nvim'

# Initialize Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
