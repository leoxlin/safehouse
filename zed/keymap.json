// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // This keymap.json is meant to be used with the karabiner configs
  // The cmd key is mapped to ctrl in some cases to keep the key bindings
  // consistent between Linux and OSX
  {
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-=": ["zed::IncreaseBufferFontSize", { "persist": false }],
      "ctrl-+": ["zed::IncreaseBufferFontSize", { "persist": false }],
      "ctrl--": ["zed::DecreaseBufferFontSize", { "persist": false }],
      "ctrl-0": ["zed::ResetBufferFontSize", { "persist": false }],
      "ctrl-o": "file_finder::Toggle",
      "ctrl-shift-o": ["projects::OpenRecent", { "create_new_window": false }],
      "ctrl-q": "zed::Quit",
      "ctrl-s": "workspace::Save",
      "ctrl-w": "workspace::CloseWindow",
      "ctrl-n": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-b": "editor::GoToDefinition",
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-r": "buffer_search::DeployReplace",
      "ctrl-a": "editor::SelectAll",
      "ctrl-c": "editor::Copy",
      "ctrl-v": "editor::Paste",
      "ctrl-x": "editor::Cut",
      "ctrl-z": "editor::Undo",
      "ctrl-shift-z": "editor::Redo",
      "ctrl-/": ["editor::ToggleComments", { "advance_downwards": false }],
      "ctrl-[": "editor::Outdent",
      "ctrl-]": "editor::Indent",
    },
  },
  {
    "context": "VimControl",
    "bindings": {
      "ctrl-w": "pane::CloseActiveItem",
    },
  },
  {
    "context": "ProjectPanel",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-left": "project_panel::CollapseAllEntries",
      "ctrl-n": "project_panel::NewFile",
      "ctrl-d": "project_panel::Duplicate",
      "alt-ctrl-n": "project_panel::NewDirectory",
      "ctrl-x": "project_panel::Cut",
      "ctrl-c": "project_panel::Copy",
      "ctrl-v": "project_panel::Paste",
      "ctrl-alt-c": "workspace::CopyPath",
      "alt-ctrl-shift-c": "workspace::CopyRelativePath",
      "ctrl-backspace": ["project_panel::Trash", { "skip_prompt": true }],
      "ctrl-delete": ["project_panel::Delete", { "skip_prompt": false }],
      "alt-ctrl-r": "project_panel::RevealInFileManager",
      "ctrl-shift-enter": "workspace::OpenWithSystem",
      "ctrl-alt-backspace": ["project_panel::Delete", { "skip_prompt": false }],
      "ctrl-alt-shift-f": "project_panel::NewSearchInDirectory",
    },
  },
  {
    "context": "Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-c": "terminal::Copy",
      "ctrl-v": "terminal::Paste",
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-k": "terminal::Clear",
    },
  },
]
