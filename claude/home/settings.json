{
  "model": "opus",
  "effortLevel": "high",
  "enabledPlugins": {
    "lapdog@lapdog": true
  },
  "permissions": {
    "allow": [
      "Bash(find *)",
      "Bash(helm template *)",
      "Bash(mkdir *)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id"
    ]
  },
  "extraKnownMarketplaces": {
    "lapdog": {
      "source": {
        "source": "github",
        "repo": "DataDog/dd-apm-test-agent"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  }
}
