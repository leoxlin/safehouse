#!/bin/bash

mkdir -p $HOME/.zsh
if [ ! -e $HOME/.zsh/ohmyzsh ]; then
  git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git $HOME/.zsh/ohmyzsh
fi

mkdir -p $HOME/.vim/bundle
if [ ! -e $HOME/.vim/bundle/Vundle.vim ]; then
  git clone https://github.com/VundleVim/Vundle.vim.git $HOME/.vim/bundle/Vundle.vim
fi


if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if [[ "$(uname)" == "Darwin" ]]; then
  export BREW_PATH="/opt/homebrew/bin"
else
  export BREW_PATH="/home/linuxbrew/.linuxbrew/bin"
fi

$BREW_PATH/brew bundle
$BREW_PATH/mise trust ./mise/config.toml
$BREW_PATH/mise install
