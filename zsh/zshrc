# Zsh configuration
export EDITOR=vim
PROMPT_EOL_MARK=''

# Enable Zsh completions
autoload -Uz compinit
if [ "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null)" ]; then
    compinit
else
    compinit -C
fi

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' ignored-patterns '*/Media/*' 'Media'
zstyle ':completion:*' max-depth 1
zstyle ':completion:*' timeout 1

if [ -e "/opt/homebrew" ]; then
  export PATH="/opt/homebrew/bin:$PATH"
  export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
  export PATH="/opt/homebrew/opt/binutils/bin:$PATH"
  export PATH="/opt/homebrew/opt/bzip2/bin:$PATH"
  export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
fi

[ -e "/home/linuxbrew/.linuxbrew/bin" ] && export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
[ -e "/home/linuxbrew/.linuxbrew/sbin" ] && export PATH="/home/linuxbrew/.linuxbrew/sbin:$PATH"
[ -e "$HOME/Tools" ] && export PATH="$HOME/Tools:$PATH"
[ -e "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"
[ -e "$HOME/.lmstudio/bin" ] && export PATH="$PATH:$HOME/.lmstudio/bin"

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

for f in $(find ~/.zsh/plugins/ -maxdepth 1 -type f -name '*.zsh'); do
  source $f;
done

command -v keychain > /dev/null && keychain -q ~/.ssh/id_ed25519

if `command -v zeditor > /dev/null` && [[ ! -f ~/.local/bin/zed ]]; then
    ln -s "$(command -v zeditor)" ~/.local/bin/zed
fi

if `command -v nvim > /dev/null` && [[ ! -f ~/.local/bin/nvim ]]; then
    ln -s "$(command -v nvim)" ~/.local/bin/nvim
fi

# Initialize zoxide (smarter cd)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Initialize Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

