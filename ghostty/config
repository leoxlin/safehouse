# *> ~/.config/ghostty/config

theme = "Everblush"

# MacOS specific configs
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden

# Stop the annoying bell
bell-features = no-system,no-audio,no-attention,no-title,no-border
# Load system configs specific to OS

keybind = ctrl+insert=unbind
keybind = ctrl+\=unbind
keybind = ctrl+]=unbind

keybind = ctrl+t=new_tab
keybind = ctrl+w=close_tab:this
keybind = ctrl+k=clear_screen
keybind = ctrl+n=new_window
keybind = ctrl+q=close_window
keybind = ctrl+shift+r=reload_config
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard

keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

keybind = ctrl+shift+arrow_left=new_split:left
keybind = ctrl+shift+arrow_right=new_split:right
keybind = ctrl+shift+arrow_up=new_split:up
keybind = ctrl+shift+arrow_down=new_split:down
keybind = ctrl+arrow_left=goto_split:left
keybind = ctrl+arrow_right=goto_split:right
keybind = ctrl+arrow_up=goto_split:up
keybind = ctrl+arrow_down=goto_split:down
