# Zsh configuration
export EDITOR=vim
PROMPT_EOL_MARK=''

# Enable Zsh completions
autoload -Uz compinit
if [ "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null)" ]; then
    compinit
else
    compinit -C
fi

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' ignored-patterns '*/Media/*' 'Media'
zstyle ':completion:*' max-depth 1
zstyle ':completion:*' timeout 1

if [ -e "/opt/homebrew" ]; then
  export PATH="/opt/homebrew/bin:$PATH"
  export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
  export PATH="/opt/homebrew/opt/binutils/bin:$PATH"
  export PATH="/opt/homebrew/opt/bzip2/bin:$PATH"
  export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
fi

[ -e "/home/linuxbrew/.linuxbrew/bin" ] && export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
[ -e "/home/linuxbrew/.linuxbrew/sbin" ] && export PATH="/home/linuxbrew/.linuxbrew/sbin:$PATH"
[ -e "$HOME/Tools" ] && export PATH="$HOME/Tools:$PATH"
[ -e "$HOME/.lmstudio/bin" ] && export PATH="$HOME/.lmstudio/bin:$PATH"
[ -e "$HOME/.kimi-code/bin" ] && export PATH="$HOME/.kimi-code/bin:$PATH"
[ -e "$HOME/.kimi-webbridge/bin" ] && export PATH="$HOME/.kimi-webbridge/bin:$PATH"
[ -e "$HOME/.local/share/pi-node/current/bin" ] && export PATH="$HOME/.local/share/pi-node/current/bin:$PATH"

for f in $(find ~/.zsh/plugins/ -maxdepth 1 -type f -name '*.zsh'); do
  source $f;
done

function lfg_worktree_setup() {
  local worktree_path="$1"
  command -v mise >/dev/null 2>&1 || return 0
  if mise trust --show -C "$worktree_path" 2>/dev/null | grep -q ': untrusted'; then 
    mise trust -y -q -C "$worktree_path"
  fi
}

if [ -e "$HOME/.local/share/lfg" ]; then
  source "$HOME/.local/share/lfg/lfg.zsh"
fi

# Initialize mise (tool version management)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
  eval "$(mise completion zsh)"
fi

# Initialize fnox (secret management)
if command -v fnox >/dev/null 2>&1; then
  eval "$(fnox activate zsh)"
  eval "$(fnox completion zsh)"
fi

# Initialize zoxide (smarter cd)
if `command -v zoxide >/dev/null 2>&1`; then
  eval "$(zoxide init zsh)"
fi

# Initialize starship (faster prompt)
if `command -v starship >/dev/null 2>&1`; then
  eval "$(starship init zsh)"
fi

if `command -v zeditor > /dev/null` && [[ ! -f ~/.local/bin/zed ]]; then
    ln -s "$(command -v zeditor)" ~/.local/bin/zed
fi

if `command -v nvim > /dev/null` && [[ ! -f ~/.local/bin/nvim ]]; then
    ln -s "$(command -v nvim)" ~/.local/bin/nvim
fi

[ -e "$HOME/.env" ] && export $(grep -v '^#' $HOME/.env | xargs)
[ -e "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

