# WARNING: These bindings require karabiner mappings to work on OSX

theme = "Everblush"
selection-background = #232a2d
unfocused-split-opacity = 1
shell-integration-features = no-title

# Working directory
working-directory = inherit
tab-inherit-working-directory = home

# OSX specific configs
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
gtk-titlebar-style = tabs
gtk-toolbar-style = raised
gtk-tabs-location = top
window-show-tab-bar = always

# Disable notifications
bell-features = no-system,no-audio,no-attention,no-title,no-border
desktop-notifications = false

# Disable close confirmation
confirm-close-surface = false

# Bind shift enter to work properly
keybind = shift+enter=text:\n

# More natural copy paste but preserve SIGINT
# ctrl+c sends SIGINT if nothing to copy
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard

# Rebind splits and navigation
# Splits mirror tmux pane bindings (\ right, ] down, w kill)
split-divider-color = #323c41
keybind = ctrl+\=new_split:right
keybind = ctrl+]=new_split:down
keybind = ctrl+shift+\=new_split:left
keybind = ctrl+shift+]=new_split:up

keybind = ctrl+shift+arrow_left=goto_split:left
keybind = ctrl+shift+arrow_right=goto_split:right
keybind = ctrl+shift+arrow_up=goto_split:up
keybind = ctrl+shift+arrow_down=goto_split:down

# Vim-like split navigation (mirrors tmux h/j/k/l)
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right

# Misc keybinds
keybind = ctrl+k=clear_screen

# Tab management (native ghostty tabs)
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_surface
keybind = ctrl+arrow_right=next_tab
keybind = ctrl+arrow_left=previous_tab

keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

keybind = ctrl+shift+r=reload_config

# Unbind clashing keybinds
keybind = ctrl+shift+o=unbind
