theme = "Everblush"
selection-background = #232a2d
unfocused-split-opacity = 1
# OSX specific configs
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
gtk-titlebar-style = native
gtk-toolbar-style = raised
gtk-tabs-location = top
window-show-tab-bar = always

# Disable notifications
bell-features = no-system,no-audio,no-attention,no-title,no-border
desktop-notifications = false

# Disable close confirmation
confirm-close-surface = false

# Bind shift enter to work properly
keybind = shift+enter=text:\n

# Send terminal control keys before passing through the original key
keybind = unconsumed:super+c=text:\x03
keybind = unconsumed:super+a=text:\x01
keybind = unconsumed:super+e=text:\x05
keybind = super+v=paste_from_clipboard

# Rebind splits and navigation
keybind = super+\=new_split:right
keybind = super+]=new_split:down
keybind = super+shift+\=new_split:left
keybind = super+shift+]=new_split:up

keybind = super+shift+arrow_left=goto_split:left
keybind = super+shift+arrow_right=goto_split:right
keybind = super+shift+arrow_up=goto_split:up
keybind = super+shift+arrow_down=goto_split:down

# Misc keybinds
keybind = super+k=clear_screen

# Tab management (native ghostty tabs)
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+arrow_right=next_tab
keybind = super+arrow_left=previous_tab

keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=goto_tab:9

keybind = super+shift+r=reload_config

# Unbind clashing keybinds
keybind = super+shift+o=unbind
